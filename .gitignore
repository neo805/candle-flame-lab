# The published repository is a curated, ready-to-open release tree.
# Local sources, backups, teaching resources, and root-level working copies stay untracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md
!/README.en.md
!/LICENSE
!/index.html
!/zh
!/en
!/docs
/docs/MODEL_NOTES.md
